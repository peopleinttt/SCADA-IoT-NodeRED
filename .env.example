# Copia este archivo a .env y llena los valores. .env NO se sube a ningun lado.
# Node-RED lee estas variables del entorno del proceso (arranca.sh las carga).

# ---- Firebase Realtime Database ------------------------------------------
# Sin barra final. Ojo: las bases creadas fuera de us-central1 usan el dominio
# https://<nombre>.<region>.firebasedatabase.app en vez de .firebaseio.com
FIREBASE_DB_URL=https://PROYECTO-default-rtdb.firebaseio.com
FIREBASE_API_KEY=AIza...
PLANTA_ID=planta_01

# Cuenta de servicio que ESCRIBE (Node-RED). Su UID va en database.rules.json.
FB_INGESTOR_EMAIL=ingestor@ejemplo.mx
FB_INGESTOR_PASS=cambia-esta-clave-larga

# Cuenta que solo LEE (la pagina web). Su UID tambien va en las reglas.
FB_VISOR_EMAIL=visor@ejemplo.mx
FB_VISOR_PASS=cambia-esta-otra-clave

# Alternativa al login automatico: un token fijo (secreto de BD, deprecado).
# Si FB_INGESTOR_* esta bien configurado, deja esto vacio.
FIREBASE_AUTH=

# ---- Endpoint de ingesta --------------------------------------------------
# Debe coincidir con INGEST_KEY del sketch de Wokwi. Generala con:
#   openssl rand -hex 24
INGEST_KEY=cambia-esta-clave-compartida

# ---- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=512
# Presupuesto de razonamiento; dejalo vacio para no mandar thinkingConfig.
GEMINI_THINKING_BUDGET=

# Frenos de consumo de la cuota gratuita
DIAG_MUESTRAS=12
DIAG_MAX_CARACTERES=1800
DIAG_MAX_DIA=200
DIAG_MIN_REPETIR_MIN=30

# ---- Umbrales de la maquina ----------------------------------------------
UMBRAL_TEMP_C=75
UMBRAL_VIB_MM_S=7.1

# ---- Instrumentacion ------------------------------------------------------
# Ruta absoluta. Si lleva espacios (como "dev aws"), va entre comillas dobles:
# arranca.sh carga este archivo con "." de bash.
DATOS_DIR="/Users/TU_USUARIO/ruta/al/repo/datos"
TZ_REPORTE=America/Mexico_City
TOL_FUTURO_S=120
TOL_PASADO_S=3600

# ---- Actividad 2: planta sustituta (pestana A2 · Sustituto) ---------------
# Vacio = valor por omision. A2_SUSTITUTO=0 apaga el sustituto (cuando el
# cliente apunte a Factory I/O): el emulador no avanza y el servidor Modbus se
# va a un puerto efimero, asi que 5020 deja de contestar.
A2_SUSTITUTO=
# Puerto y host donde escucha el servidor Modbus del sustituto (5020, 127.0.0.1)
A2_SUST_PUERTO=
A2_SUST_HOST=
# Sobrescribe la semilla de config/sustituto_a2.json
A2_SUST_SEMILLA=
# Rutas; arranca.sh pone las del repo si quedan vacias
A2_MAPA=
A2_SUST_CONFIG=

# ---- Actividad 2: destino Modbus del cliente (sonda y A2-Planta) ----------
# Vacio = el sustituto local: 127.0.0.1, puerto 5020, unidad 1. Para Factory
# I/O en Azure: la IP de Tailscale de la maquina Windows y el puerto 502.
A2_MODBUS_HOST=
A2_MODBUS_PUERTO=
A2_MODBUS_UNIDAD=
# Periodo de sondeo en ms y tiempo de ida y vuelta previsto, si no los de
# config/planta_a2.json. Con ellos A2-Planta calcula la velocidad maxima de
# banda (tools/limites_planta.py hace la misma cuenta). Azure: 500 y 200.
A2_SONDEO_MS=
A2_RTT_PREVISTO_MS=
# Ruta; arranca.sh pone la del repo si queda vacia
A2_PLANTA_CONFIG=

# ---- Actividad 2: rama proceso en Firebase (pestana A2 · Nube) -----------
# 1 = escribir. Dejalo vacio hasta publicar firebase/database.rules.generado.json
# con la rama proceso: sin las reglas, cada escritura es un 401.
A2_NUBE=
# Segundos entre latidos con la linea en marcha (60 por omision); ademas se
# escribe uno por caja.
A2_LATIDO_S=
# Segundos entre latidos con la linea fuera de marcha y sin cambio de estado
# (900 por omision). Un cambio de estado_linea produce un latido inmediato.
A2_LATIDO_REPOSO_S=

# ---- Editor de Node-RED (adminAuth, paso S2 de la fase 3) -----------------
# Los escribe ./prepara_admin.sh (pide usuario y contrasena; guarda el hash
# bcrypt entre comillas simples). Sin los dos, Node-RED no sirve el editor ni
# la API de administracion; flujos, HMI e ingesta siguen. No hay contrasena
# por omision y la contrasena nunca se guarda en claro.
NODE_RED_ADMIN_USER=
NODE_RED_ADMIN_HASH=

# ---- Actividad 2: capa de materiales (pestana A2 · Materiales, fase 3) ------
# 1 = encender. Sin 1 la pestana no hace nada, no crea archivos y la HMI no
# muestra la tarjeta "Materials layer".
A2_MATERIALES=
# Ruta de la configuracion; arranca.sh pone config/materiales.json si queda vacia
A2_MAT_CONFIG=
